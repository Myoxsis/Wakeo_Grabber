{
  "manifest_version": 3,
  "name": "Wakeo Grabber",
  "version": "0.2.0",
  "description": "Capture Wakeo.com links from page and network requests.",
  "action": {
    "default_title": "Wakeo Grabber",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "tabs", "sidePanel"],
  "host_permissions": ["*://*.wakeo.com/*", "*://wakeo.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.wakeo.com/*", "*://wakeo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
