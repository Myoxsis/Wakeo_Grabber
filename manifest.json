{
  "manifest_version": 3,
  "name": "Geneanet Explorer",
  "version": "0.1.0",
  "description": "Capture genealogy details while browsing family trees.",
  "action": {
    "default_title": "Geneanet Explorer",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
